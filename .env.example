# ============================================================
# AskAra+ — Environment Variables
# ============================================================
# Copy to .env for local dev. Set these in Railway/Render dashboard for prod.
# ============================================================

# === LLM API (SEA-LION) ===
SEALION_API_KEY=your-sea-lion-api-key
SEALION_API_BASE=https://api.sea-lion.ai/v1
SEALION_MODEL=aisingapore/Qwen-SEA-LION-v4-32B-IT
SEALION_VL_MODEL=aisingapore/Gemma-SEA-LION-v4-27B-IT

# === Speech-to-Text (Groq Whisper) ===
GROQ_API_KEY=your-groq-api-key

# === MCP Server (internal — always localhost in container) ===
MCP_SERVER_URL=http://localhost:8001

# === ChromaDB ===
# Local dev: relative path from backend/
# Docker/Railway: /app/data/chromadb
CHROMA_PERSIST_DIR=../data/chromadb
CHROMA_COLLECTION=gov_documents

# === CORS — Frontend URL ===
# Set to your Vercel deployment URL in production
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# === LLM Tuning (optional) ===
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60.0

# ============================================================
# Frontend (.env.local in frontend/ directory)
# ============================================================
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# For production: NEXT_PUBLIC_BACKEND_URL=https://your-app.up.railway.app